<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Focus ring is thick and bright so it is easy to follow with a D-pad / controller -->
    <item android:state_focused="true" android:state_selected="true">
        <shape>
            <solid android:color="#552E4F9A" />
            <corners android:radius="20dp" />
            <stroke android:width="3dp" android:color="#5EA2FF" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape>
            <solid android:color="#26FFFFFF" />
            <corners android:radius="20dp" />
            <stroke android:width="3dp" android:color="#5EA2FF" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape>
            <solid android:color="#552E4F9A" />
            <corners android:radius="20dp" />
            <stroke android:width="1dp" android:color="#6688AEFF" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="#00000000" />
            <corners android:radius="20dp" />
            <stroke android:width="1dp" android:color="#3D5A6A8A" />
        </shape>
    </item>
</selector>

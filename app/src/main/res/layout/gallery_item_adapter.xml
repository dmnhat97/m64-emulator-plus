<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:background="@drawable/bg_menu_item_state"
    android:focusable="true"
    android:id="@+id/galleryItem"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:padding="8dp"
    android:orientation="vertical" >

    <ImageView
        android:id="@+id/imageArt"
        android:layout_width="@dimen/galleryImageWidth"
        android:layout_height="@dimen/galleryImageHeight"
        android:scaleType="fitXY"
        android:adjustViewBounds="true"
        android:layout_gravity="center_horizontal"
        android:clipToOutline="true"
        android:background="@drawable/bg_gallery_card"
        android:src="@drawable/default_coverart" />

    <LinearLayout
        android:id="@+id/info"
        android:layout_width="@dimen/galleryImageWidth"
        android:layout_height="@dimen/galleryTextHeight"
        android:background="@drawable/bg_gallery_info"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:layout_marginTop="6dp"
        android:orientation="horizontal" >
        
        <TextView
            android:id="@+id/text1"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:text="@string/galleryItemAdapter_dummyText"
            android:textAppearance="?android:attr/textAppearanceSmall"
            android:textColor="@color/mupen_text_primary"
            android:maxLines="2"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/favBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="&#9733;"
            android:textColor="#FFC857"
            android:textSize="16sp"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>

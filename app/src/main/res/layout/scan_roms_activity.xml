<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/linearLayout1"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:background="@color/mupen_black">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:paddingTop="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/buttonBack"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_tab_icon_button"
                    android:contentDescription="Back"
                    android:padding="10dp"
                    android:src="@drawable/ic_arrow_left"
                    android:tint="@color/mupen_text_secondary" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:text="@string/menuItem_refreshRoms"
                    android:textColor="@color/mupen_text_primary"
                    android:textSize="27sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="6dp"
                android:padding="14dp"
                android:background="@drawable/bg_settings_card">

                <TextView
                    android:id="@+id/text1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/scanRomsDialog_selectRom"
                    android:textColor="@color/mupen_text_primary"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/textNoSafSupport"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/mupen_text_secondary"
                    android:textSize="13sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical">

                    <Button
                        android:id="@+id/buttonFilePicker"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginBottom="10dp"
                        android:background="@drawable/bg_import_action_file"
                        android:drawableStart="@drawable/ic_storage"
                        android:drawablePadding="8dp"
                        android:gravity="start|center_vertical"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:singleLine="true"
                        android:ellipsize="end"
                        android:text="@string/scanRomsDialog_select_file"
                        android:textAllCaps="false"
                        android:textColor="@color/mupen_text_primary" />

                    <Button
                        android:id="@+id/buttonFolderPicker"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:background="@drawable/bg_import_action_folder"
                        android:drawableStart="@drawable/ic_folder"
                        android:drawablePadding="8dp"
                        android:gravity="start|center_vertical"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:singleLine="true"
                        android:ellipsize="end"
                        android:text="@string/scanRomsDialog_select_folder"
                        android:textAllCaps="false"
                        android:textColor="@color/mupen_text_primary" />
                </LinearLayout>

                <TextView
                    android:id="@+id/fileDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textColor="@color/mupen_text_secondary"
                    android:textSize="13sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="vertical"
                android:padding="14dp"
                android:background="@drawable/bg_settings_card">

                <CheckBox
                    android:id="@+id/checkBox1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:buttonTint="@color/scan_checkbox_tint"
                    android:text="@string/scanRomsDialog_searchZips"
                    android:textColor="@color/mupen_text_primary" />

                <CheckBox
                    android:id="@+id/checkBox2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:buttonTint="@color/scan_checkbox_tint"
                    android:text="@string/scanRomsDialog_downloadArt"
                    android:textColor="@color/mupen_text_primary" />

                <CheckBox
                    android:id="@+id/checkBox3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:buttonTint="@color/scan_checkbox_tint"
                    android:text="@string/scanRomsDialog_clearGallery"
                    android:textColor="@color/mupen_text_primary" />

                <CheckBox
                    android:id="@+id/checkBox4"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:buttonTint="@color/scan_checkbox_tint"
                    android:text="@string/scanRomsDialog_scanSubdirectories"
                    android:textColor="@color/mupen_text_primary" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
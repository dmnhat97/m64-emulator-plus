<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_menu_item_state"
    android:gravity="center_vertical"
    android:minHeight="58dip"
    android:paddingTop="4dp"
    android:paddingBottom="4dp"
    android:layout_marginStart="10dp"
    android:layout_marginEnd="10dp"
    android:layout_marginTop="4dp"
    android:layout_marginBottom="4dp"
    android:paddingEnd="?android:attr/scrollbarSize"
    tools:ignore="RtlSymmetry" >

    <ImageView
        android:id="@+id/icon"
        android:layout_width="22dp"
        android:layout_height="22dp"
        android:layout_gravity="center"
        android:tint="@color/mupen_text_secondary"
        android:layout_marginStart="16dip"
        tools:ignore="ContentDescription" />

    <RelativeLayout
        android:layout_width="0dip"
        android:layout_height="wrap_content"
        android:layout_marginBottom="5dip"
        android:layout_marginEnd="6dip"
        android:layout_marginStart="14dip"
        android:layout_marginTop="5dip"
        android:layout_weight="1" >

        <TextView
            android:id="@+id/text1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="?android:attr/textAppearanceMedium"
            android:textColor="@color/mupen_text_primary"
            android:maxLines="1"
            android:ellipsize="end"
            android:textIsSelectable="false" />

        <TextView
            android:id="@+id/text2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignStart="@id/text1"
            android:layout_below="@id/text1"
            android:textAppearance="?android:attr/textAppearanceSmall"
            android:textSize="14sp"
            android:textColor="@color/mupen_text_secondary"
            android:textIsSelectable="false" />
    </RelativeLayout>

    <ImageView
        android:id="@+id/indicator"
        tools:ignore="ContentDescription"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center" />

    <LinearLayout
        android:id="@android:id/widget_frame"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="vertical" />

</LinearLayout>
<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="false"
    style="@style/MupenTheme_Dark_Sidebar"> <!-- Setting this as a theme makes MenuListView throw exception -->

    <!-- This is needed to prevent the keyboard from showing up at startup -->
   <LinearLayout
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:layout_width="0px"
        android:layout_height="0px"
        tools:ignore="UselessLeaf" />

    <!-- activity view -->

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:id="@+id/coordLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical" >

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/gridview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:gravity="center"
            android:nextFocusLeft="@id/menuItem_openDrawer"
            android:nextFocusRight="@id/menuItem_refreshRoms"
            app:fastScrollEnabled="true"
            app:fastScrollHorizontalThumbDrawable="@drawable/thumb_drawable"
            app:fastScrollHorizontalTrackDrawable="@drawable/line_drawable"
            app:fastScrollVerticalThumbDrawable="@drawable/thumb_drawable"
            app:fastScrollVerticalTrackDrawable="@drawable/line_drawable"
            app:layout_behavior="@string/appbar_scrolling_view_behavior"
            android:paddingBottom="154dip"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:background="@color/mupen_black"
            />

        <ImageView
            android:id="@+id/gallery_empty_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:src="@drawable/ic_n64_controller"
            tools:ignore="ContentDescription" />

        <LinearLayout
            android:id="@+id/gallery_empty_state"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/empty_library_title"
                android:textColor="@color/mupen_text_primary"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_horizontal"
                android:text="@string/empty_library_subtitle"
                android:textColor="@color/mupen_text_secondary"
                android:textSize="13sp" />

            <Button
                android:id="@+id/emptyStateImportButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_tab_center_action"
                android:minWidth="150dp"
                android:onClick="onFabRefreshRomsClick"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="@string/empty_library_cta"
                android:textAllCaps="false"
                android:textColor="@android:color/white" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/settingsPanelHost"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            android:background="@color/mupen_black"
            app:layout_behavior="@string/appbar_scrolling_view_behavior">

            <include
                layout="@layout/settings_hub_content"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginBottom="110dp" />
        </FrameLayout>

        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/appBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:elevation="0dp"
            android:background="@drawable/bg_black_gradient">

            <androidx.appcompat.widget.Toolbar
                android:id="@+id/toolbar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:layout_collapseMode="pin"
                app:layout_scrollFlags="scroll|enterAlways|snap"
                android:background="@color/mupen_black"
                android:minHeight="?attr/actionBarSize">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="10dp"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    android:background="@drawable/bg_top_panel">

                    <TextView
                        android:id="@+id/galleryTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        android:text="@string/app_name"
                        style="@style/TextAppearance.Mupen.Title"
                        android:gravity="center_horizontal" />

                    <TextView
                        android:id="@+id/gallerySubtitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        app:layout_constraintTop_toBottomOf="@id/galleryTitle"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        android:layout_marginTop="2dp"
                        android:text="@string/actionSearchRoms"
                        style="@style/TextAppearance.Mupen.Subtitle"
                        android:gravity="center_horizontal" />

                    <View
                        android:id="@+id/searchDivider"
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        app:layout_constraintTop_toBottomOf="@id/gallerySubtitle"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        android:layout_marginTop="10dp"
                        android:background="@color/mupen_outline" />

                    <androidx.appcompat.widget.SearchView
                        android:id="@+id/menuItem_search"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:theme="@style/ThemeOverlay.AppCompat.Dark"
                        app:layout_constraintTop_toBottomOf="@id/searchDivider"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        android:layout_marginTop="8dp"
                        android:nextFocusLeft="@id/gridview"
                        android:nextFocusDown="@id/gridview"
                        app:queryHint="@string/actionSearchRoms"
                        android:textColorHint="@color/mupen_text_secondary"
                        app:queryBackground="@drawable/bg_transparent"
                        app:iconifiedByDefault="false"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        app:searchIcon="@null" />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </androidx.appcompat.widget.Toolbar>

            <LinearLayout
                android:id="@+id/filterBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingStart="22dp"
                android:paddingEnd="22dp"
                android:paddingBottom="10dp"
                app:layout_scrollFlags="scroll|enterAlways|snap">

                <TextView
                    android:id="@+id/filterAll"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:minWidth="88dp"
                    android:layout_marginEnd="10dp"
                    android:background="@drawable/bg_filter_chip"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:nextFocusDown="@id/gridview"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:text="@string/gallery_filter_all"
                    android:textColor="@color/mupen_text_primary"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/filterFavorites"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:minWidth="88dp"
                    android:background="@drawable/bg_filter_chip"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:nextFocusDown="@id/gridview"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:text="@string/gallery_filter_favorites"
                    android:textColor="@color/mupen_text_primary"
                    android:textSize="14sp" />
            </LinearLayout>

        </com.google.android.material.appbar.AppBarLayout>

        <FrameLayout
            android:id="@+id/homeTabBarWrap"
            android:layout_width="match_parent"
            android:layout_height="92dp"
            android:layout_gravity="bottom"
            android:layout_marginStart="34dp"
            android:layout_marginEnd="34dp"
            android:layout_marginBottom="10dp"
            android:clipChildren="false"
            android:clipToPadding="false">

            <LinearLayout
                android:id="@+id/homeTabBar"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:layout_gravity="bottom"
                android:background="@drawable/bg_home_tabbar"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="12dp">

                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <ImageButton
                    android:id="@+id/tabHome"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_tab_icon_button_active"
                    android:src="@drawable/ic_home"
                    android:tint="#CAE4FF"
                    android:onClick="onTabHomeClicked"
                    android:contentDescription="@string/tab_home" />

                <Space
                    android:layout_width="70dp"
                    android:layout_height="1dp" />

                <Space
                    android:layout_width="70dp"
                    android:layout_height="1dp"
                    />

                <ImageButton
                    android:id="@+id/tabSettings"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_tab_icon_button"
                    android:src="@drawable/ic_settings"
                    android:tint="#8EA8CF"
                    android:onClick="onTabSettingsClicked"
                    android:contentDescription="@string/tab_settings" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/tabActionButton"
                android:layout_width="66dp"
                android:layout_height="66dp"
                android:layout_gravity="center_horizontal|top"
                android:layout_marginTop="0dp"
                android:background="@drawable/bg_tab_center_action"
                android:src="@drawable/ic_plus"
                android:tint="@android:color/white"
                android:onClick="onTabCenterActionClicked"
                android:contentDescription="@string/menuItem_refreshRoms" />
        </FrameLayout>

        <!-- Gamer home UI (Jetpack Compose). The legacy views above are hidden when it is attached. -->
        <androidx.compose.ui.platform.ComposeView
            android:id="@+id/composeHome"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

    </androidx.coordinatorlayout.widget.CoordinatorLayout>

    <!-- navigation drawer -->

    <RelativeLayout
        android:layout_width="300dip"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:fitsSystemWindows="true"
        android:background="@drawable/bg_sidebar_panel"
        style="@style/MupenTheme_Dark_Sidebar">

        <paulscode.android.mupen64plusae.GameSidebar
            android:id="@+id/drawerNavigation"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:nextFocusDown="@+id/drawerNavigation"
            android:nextFocusLeft="@+id/drawerNavigation"
            android:nextFocusRight="@+id/drawerNavigation"
            android:nextFocusUp="@+id/drawerNavigation"
            style="@style/MupenTheme_Dark_Sidebar" />

        <paulscode.android.mupen64plusae.GameSidebar
            android:id="@+id/gameSidebar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true"
            android:visibility="gone"
            style="@style/MupenTheme_Dark_Sidebar" />
    </RelativeLayout>

</androidx.drawerlayout.widget.DrawerLayout>

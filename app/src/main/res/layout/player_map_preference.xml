<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/mupen_black"
    android:padding="12dp">

    <TextView
        android:id="@android:id/message"
        style="@style/alertDialogMessage"
        android:textIsSelectable="false" />

    <Button
        android:id="@+id/btnPlayer1"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginBottom="8dp"
        android:layout_weight="1"
        android:background="@drawable/bg_import_action_file"
        android:textColor="@color/mupen_text_primary"
        android:text="@string/playerMapPreference_button" />

    <Button
        android:id="@+id/btnPlayer2"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginBottom="8dp"
        android:layout_weight="1"
        android:background="@drawable/bg_import_action_file"
        android:textColor="@color/mupen_text_primary"
        android:text="@string/playerMapPreference_button" />

    <Button
        android:id="@+id/btnPlayer3"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginBottom="8dp"
        android:layout_weight="1"
        android:background="@drawable/bg_import_action_file"
        android:textColor="@color/mupen_text_primary"
        android:text="@string/playerMapPreference_button" />

    <Button
        android:id="@+id/btnPlayer4"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_weight="1"
        android:background="@drawable/bg_import_action_file"
        android:textColor="@color/mupen_text_primary"
        android:text="@string/playerMapPreference_button" />

</LinearLayout>
<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingBottom="8dp"
    android:background="@drawable/bg_sidebar_panel" >

    <LinearLayout
        android:id="@+id/imageLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:focusable="false"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="14dp" >

        <ImageView
            android:id="@+id/imageArt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:cropToPadding="false"
            android:focusable="false"
            android:background="@drawable/bg_gallery_card"
            android:padding="8dp"
            android:src="@drawable/default_coverart"
            tools:ignore="ContentDescription" />
    </LinearLayout>

    <TextView
        android:id="@+id/gameTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:focusable="false"
        android:background="@drawable/bg_gallery_info"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:padding="12dip"
        android:text="@string/galleryItemAdapter_dummyText"
        android:maxLines="2"
        android:ellipsize="end"
        style="@style/TextAppearance.Mupen.Title" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/mupen_outline" />

</LinearLayout>